    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Flutter (Samsung A15 — USB Debug)",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/flutter_app/lib/main.dart",
            "cwd": "${workspaceFolder}/flutter_app",
            "deviceId": "RZCX20LSQ7V",
            "args": [
                "--debug"
            ],
            "flutterMode": "debug"
        }
    ]
}